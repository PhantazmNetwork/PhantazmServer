#!/bin/sh

# These variables are sourced from a config file later
code_branch=""
config_branch=""
config_repo=""
code_repo=""

# HELPER FUNCTIONS

die () {
    [ -n "$1" ] && printf "\033[31;1m[ERROR]\033[0m %s\n" "$1"
    exit 1
}

cd_or_die () {
    cd "$1" || die "couldn't change directory"
}

escape_single_quote () {
    printf "%s" "$1" | sed "s/'/'\"'\"'/"
}

require_config () {
    [ -n "$1" ] || die "missing required configuration"
}

require_program () {
    which "$1" > /dev/null 2>&1 || die "no '$1' in PATH"
}

running () {
    if [ -z "$1" ]; then
        # no need to list processes when we don't have a PID anyway
        printf "false"
        return
    fi

    # this shellcheck wants use to use pgrep instead, but that's non-POSIX
    # shellcheck disable=SC2009
    if ps -eo pid | grep -qF "$1"; then
        printf "true"
    else
        printf "false"
    fi
}

warn () {
    printf "\033[33;1m[WARNING]\033[0m %s\n" "$1"
}

# END HELPER FUNCTIONS

# Required programs
require_program git
require_program java
require_program rsync
require_program ssh
require_program tmux

current_directory=$( pwd ) || die "can't get current directory"

# FILE VARIABLES

# Internal files that shouldn't be modified directly by the user go here
dotfile="$current_directory/.puppet"

# Real (non-symlink) server directories
server_1_dir="$dotfile/server_1"
server_2_dir="$dotfile/server_2"

# Lock folder
lock_dir="$dotfile/lock"

# PID files for main and fallback servers
main_pid_file="$dotfile/main_pid"
fallback_pid_file="$dotfile/fallback_pid"

# Real (non-symlink) tmux socket files
socket_1_file="$dotfile/socket_1"
socket_2_file="$dotfile/socket_2"

# Symlinks to the real tmux socket files
main_socket_link="$dotfile/main_socket"
fallback_socket_link="$dotfile/fallback_socket"

# Written to by the server process, we read it to determine when the server has launched
temp_log="$dotfile/temp_log"
fail="$dotfile/fail"

# When the main server shuts down, it writes a line to this file so we know when to promote the fallback
signal_file="$dotfile/signal"

# Build artifacts (libraries, jar file) are written here before synchronizing to the proper target
build_dir="$dotfile/build"
build_dir_libs="$build_dir/libs"

# The configuration repo lives here
config_dir="$dotfile/config"

# Small script, generated by this one, used to launch an individual server
start_file="$dotfile/start.sh"

# The code repo lives here
src_dir="$dotfile/src"

# Files that must differ between server_1 and server_2 live here
server_1_unique_dir="$current_directory/unique_1"
server_2_unique_dir="$current_directory/unique_2"

# Files that aren't part of config, but are the same between server_1 and server_2, live here
common_dir="$current_directory/common"

# Symlinks to the main and fallback server
main_link="$current_directory/main"
fallback_link="$current_directory/fallback"

script_config="$current_directory/puppet.conf"

# END FILE VARIABLES

# CONTEXTUAL HELPER FUNCTIONS

promote_fallback () {
    cat "$fallback_pid_file" > "$main_pid_file"
    printf "" > "$fallback_pid_file"

    new_active=$( readlink -f "$fallback_socket_link" ) || die "couldn't read socket link"
    new_server=$( readlink -f "$fallback_link" ) || die "couldn't read directory link"

    if [ "$new_active" = "$socket_1_file" ]; then
        old_active="$socket_2_file"
        old_server="$server_2_dir"
    else
        old_active="$socket_1_file"
        old_server="$server_1_dir"
    fi

    rm "$fallback_socket_link" "$main_socket_link" "$fallback_link" "$main_link" || die "couldn't remove old link(s)"

    ( ln -s "$old_active" "$fallback_socket_link" && \
    ln -s "$new_active" "$main_socket_link" && \
    ln -s "$old_server" "$fallback_link" && \
    ln -s "$new_server" "$main_link" ) || die "symlink error"
}

sync_target () {
    target=$(readlink -f "$1")
    if [ "$target" = "$server_1_dir" ]; then
        rsync -ac --delete "$server_1_unique_dir/" \
        "$start_file" \
        "$common_dir/" \
        "$build_dir/" \
        "$config_dir/" \
        "$1" || die "couldn't sync server_1"
    elif [ "$target" = "$server_2_dir" ]; then
        rsync -ac --delete "$server_2_unique_dir/" \
        "$start_file" \
        "$common_dir/" \
        "$build_dir/" \
        "$config_dir/" \
        "$1" || die "couldn't sync server_2"
    else
        die "invalid synchronize symlink $1"
    fi
}

tmux_init () {
    # Only create a new session if there isn't one to use already
    tmux -S "$socket_1_file" list-sessions -F#\{session_name\} | grep -qF "server" ||
    tmux -S "$socket_1_file" new-session -d -n server -s server

    tmux -S "$socket_2_file" list-sessions -F#\{session_name\} | grep -qF "server" ||
    tmux -S "$socket_2_file" new-session -d -n server -s server
}

update_code () {
    if [ ! -d "$src_dir/.git" ]; then
        rm -rf "$src_dir" || die "couldn't clean src dir"
        git clone --recurse-submodules "$code_repo" "$src_dir" || die "couldn't clone $code_repo"
    fi

    cd_or_die "$src_dir"

    git checkout "$code_branch" || die "couldn't checkout src branch"
    git pull --recurse-submodules || die "couldn't pull src branch"

    ./gradlew -PskipBuild=snbt-builder,dev-launcher,velocity phantazm-server:copyJar phantazm-server:copyLibs || die "couldn't build src"

    rsync -ac --delete "run/server-1/libs/" "$build_dir_libs" || die "couldn't sync build libs"
    rsync -ac "run/server-1/server.jar" "$build_dir" || die "couldn't sync server.jar"
}

update_config () {
    if [ ! -d "$config_dir/.git" ]; then
        rm -rf "$config_dir" || die "couldn't clean config dir"
        git clone "$config_repo" "$config_dir" || die "couldn't clone $config_repo"
    fi

    cd_or_die "$config_dir"

    git checkout "$config_branch" || die "couldn't checkout git repo"
    git pull || die "couldn't pull git repo"
}

# END CONTEXTUAL FUNCTIONS

# CONFIGURATION

if [ ! -f "$script_config" ]; then
    printf "%s\n" "# Which branch of the Git repository 'code_repo' to pull from
code_branch=\"\"

# Which branch of the Git repository 'config_repo' to pull from
config_branch=\"\"

# The Git repository containing configuration files
config_repo=\"\"

# The Git repository containing the Phantazm server code
code_repo=\"\"" > "$script_config" || die "couldn't write default config"

    printf "Wrote initial configuration to puppet.conf\n"
    exit 0
fi

# we are using this for user configuration, so it's not meaningful to debug
# shellcheck disable=SC1090
. "$script_config"

require_config "$code_branch"
require_config "$config_branch"
require_config "$config_repo"
require_config "$code_repo"

# END CONFIGURATION

# SETUP

if [ "$1" = "setup" ]; then
    contents="$( ls -A "$current_directory" )"

    # Case is caught already by the next line, but run this check first so we have a better error message
    printf "%s" "$contents" | grep -qF ".puppet" && die "setup has already been run"

    # Shouldn't be running setup in directories that are already populated (except by puppet.conf)
    [ "$contents" = "puppet.conf" ] || die "current directory should be empty"

    # Create all required directories
    mkdir "$server_1_dir" \
    "$server_2_dir" \
    "$server_1_unique_dir" \
    "$server_2_unique_dir" \
    "$config_dir" \
    "$build_dir" \
    "$src_dir" \
    "$common_dir" || die "couldn't create all necessary directories"

    # Create all required files
    touch "$main_pid_file" "$fallback_pid_file" "$temp_log" "$fail" "$signal_file" || die "couldn't create all necessary files"

    tmux_init

    ( ln -s "$socket_1_file" "$main_socket_link" && \
    ln -s "$socket_2_file" "$fallback_socket_link" && \
    ln -s "$server_1_dir" "$main_link" && \
    ln -s "$server_2_dir" "$fallback_link" ) || die "symlink error"

    # This will replace any instances of ' with '"'"'
    escaped_signal_file=$( escape_single_quote "$signal_file" )
    escaped_fail_file=$( escape_single_quote "$fail" )

    # $start_file launches the server, create it here
    printf "%s\n" "#!/bin/sh
if ! java -Dfile.encoding=UTF-8 -jar server.jar; then
    # Indicate that launching did not succeed
    printf \"FAILED\" > '$escaped_fail_file'

    # Puppet expects a line with serverIP in it to appear eventually
    # if we didn't send it on failure, it could wait forever for us to finish
    printf \"serverIP\\n\"
fi
printf \"FINISHED\\n\" > '$escaped_signal_file'" > "$start_file"

    # This must be executable by the current user
    chmod 700 "$start_file"

    printf "%s" "Is your configuration repository '$config_repo' private? [y/n] "
    read -r response

    if [ "$response" = "y" ]; then
        printf "Enter the hostname of the repository (ex. github.com): "
        read -r hostname

        while true ; do
            printf "Enter a path to a passwordless SSH identity file (private key): "
            read -r key_path

            if [ ! -f "$key_path" ]; then
                warn "Cannot find the file referenced by $key_path"
            else
                break
            fi
        done

        ssh_dir="$HOME/.ssh"

        ssh_config_file="$ssh_dir/config"
        ssh_key_file="$dotfile/ssh_key"

        mkdir -p "$ssh_dir" || die "couldn't create .ssh"
        touch "$ssh_config_file" "$ssh_key_file" || die "couldn't touch ssh config"

        chmod 700 "$ssh_dir"
        chmod 644 "$ssh_config_file"
        chmod 600 "$ssh_key_file"

        cat "$key_path" > "$ssh_key_file"

        grep -qF "Hostname $hostname" "$ssh_config_file" || printf "%s\n\n" "Host Configuration
Hostname $hostname
IdentityFile=$ssh_key_file
IdentitiesOnly yes" >> "$ssh_config_file"
    else
        printf "Skipping credential initialization...\n"
    fi

    printf "Setup complete.\n"
    exit 0
fi

[ -d "$dotfile" ] || die "must run setup first"

if [ "$1" = "main" ]; then
    tmux_init

    tmux -S "$main_socket_link" attach-session -t server
    exit "$?"
elif [ "$1" = "fallback" ]; then
    tmux_init

    tmux -S "$fallback_socket_link" attach-session -t server
    exit "$?"
elif [ "$1" = "shutdown" ]; then
    # Acquire the folder lock first, so we err if we don't have the lock
    true
elif [ "$1" = "update-full" ]; then
    update_config
    update_code
elif [ "$1" = "update-conf" ]; then
    [ -d "$src_dir/.git" ] || die "source missing"

    update_config
elif [ "$1" = "update-code" ]; then
    [ -d "$config_dir/.git" ] || die "config missing"

    update_code
elif [ "$1" = "help" ]; then
    printf "%s\n" "USAGE: [OPTION]

This command orchestrates Phantazm servers. It allows for safely relaunching
with updated code and/or config, without interrupting existing games.
Valid values for OPTION:
  help: Print this message and exit
  setup: Create necessary files
  main: Attach to the main server console
  fallback: Attach to the fallback server console
  shutdown: Shuts down the main server
  update-full: Pulls configuration and code updates, then deploys them
  update-conf: Pulls configuration changes, then deploys them
  update-code: Pulls code changes, then deploys them
  status: Shows the status of the main and fallback server"
elif [ "$1" = "status" ]; then
    true
else
    die "unknown option"
fi

main_pid=$( cat "$main_pid_file" ) || die "couldn't read main pid file"
fallback_pid=$( cat "$fallback_pid_file" ) || die "couldn't read fallback pid file"

main_running=$( running "$main_pid" )
fallback_running=$( running "$fallback_pid" )

if [ "$1" = "status" ]; then
    printf "%s\n%s\n" "Main running: $main_running" "Fallback running: $fallback_running"
    exit 0
fi

# Code below should be exclusive due to our folder lock!
mkdir "$lock_dir" || die "an instance of this script is already running"
exit_hook () {
    rmdir "$lock_dir"
}

trap "exit_hook" EXIT

if [ "$1" = "shutdown" ]; then
    tmux -S "$main_socket_link" send-keys -t server orderly_shutdown Enter
    exit "$?"
fi

tmux_init

if [ "$main_running" = "false" ] && [ "$fallback_running" = "false" ]; then
    sync_target "$main_link"

    # Bring up the main server, record its PID
    tmux -S "$main_socket_link" send-keys -t server "sh -c 'cd ''$( escape_single_quote "$main_link" )''
printf \"%s\" \"\$\$\" > ''$( escape_single_quote "$main_pid_file" )''
exec ./start.sh'" Enter

    # Clear the fallback PID file
    printf "" > "$fallback_pid_file"
elif [ "$main_running" = "true" ] && [ "$fallback_running" = "false" ]; then
    # Main server is running, fallback is not. Synchronize it.
    sync_target "$fallback_link"

    printf "" > "$temp_log"
    printf "" > "$fail"
    printf "" > "$signal_file"

    # Start up the fallback server...
    tmux -S "$fallback_socket_link" send-keys -t server "sh -c 'cd ''$( escape_single_quote "$fallback_link" )''
printf \"%s\" \"\$\$\" > ''$( escape_single_quote "$fallback_pid_file" )''
exec ./start.sh | tee ''$( escape_single_quote "$temp_log" )'''" Enter

    # ... and wait until it's ready before we continue
    ( tail -f -n +1 "$temp_log" & ) | grep -qF "serverIP"

    # Fallback may not be running. If it isn't, just quit and don't shut down the main server
    [ "$( cat "$fail" )" = "FAILED" ] && die "error launching fallback"

    # Shut down the main server, and wait for it to finish
    tmux -S "$main_socket_link" send-keys -t server orderly_shutdown Enter

    # We always write FINISHED to $signal_file when start.sh is done
    ( tail -f -n +1 "$signal_file" & ) | grep -qF "FINISHED"

    # Switch up our symlinks so that the old main server is the new fallback, and vice-versa.
    promote_fallback
elif [ "$main_running" = "false" ] && [ "$fallback_running" = "true" ]; then
    warn "invalid state detected; fallback is running but main is not"
    printf "Promote fallback to main? [y/n]: "

    read -r should_promote
    [ "$should_promote" = "y" ] && promote_fallback
else
    die "both main and fallback are running"
fi