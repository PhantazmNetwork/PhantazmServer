#!/bin/bash
# c2301c68dfe54232af2a63a47cc8b782

# INSTALL INSTRUCTIONS
# cd to the directory this script file is in, then make sure this file is owned by root
# configure the script as needed by editing variables in the USER CONFIG section below
# validate the integrity of the script file, then run './puppet install ./puppet' as root
#
# 'puppet help' for more info

## Configuration

# Program name, can be changed in case of conflicts
pname="puppet"

# Server file owner
server_user="phantazm-server"

# Install locations
bin_dir="/usr/local/bin"
data_dir="/usr/local/etc/$pname"
log_dir="/var/log/$pname"

# Directory where socket and PID files are stored
pid_dir="$data_dir/pid"

# Used to implement a simple folder-based mutex on this script
lock_folder="$data_dir/lock"

# 'main' and 'fallback' PID files
main_pid_file="$pid_dir/main.pid"
fallback_pid_file="$pid_dir/fallback.pid"

# Symlinks to the actual socket files
main_socket="$data_dir/main.sock"
fallback_socket="$data_dir/fallback.sock"

# Socket files
socket_1="$data_dir/socket_1.sock"
socket_2="$data_dir/socket_2.sock"

# Temporary log file, used to watch fallback server output
temp_log="$data_dir/log"

# Server directory
server_dir="$data_dir/servers"
server_1="$server_dir/server_1"
server_2="$server_dir/server_2"

config="$server_dir/config"
build="$server_dir/build"
src="$server_dir/src"
blob="$server_dir/server.tar.gz"
common="$server_dir/common"
signal="$common/SIGNAL"

server_1_unique="$server_dir/unique_1"
server_2_unique="$server_dir/unique_2"

# Symlinks
main="$data_dir/main"
fallback="$data_dir/fallback"
logs="$common/logs"

# BEGIN USER CONFIG (you can change these options before installing)

# Git repository branches
code_branch="dev"
config_branch="just-in-case"

# Repositories
config_repo="git@Configuration:PhantazmNetwork/Configuration.git"
code_repo="https://github.com/PhantazmNetwork/PhantazmServer"

# END USER CONFIG

# Get the currently running user id
user_id="$(id -u)"

check_dependency () {
  if ! which "$1" > /dev/null; then
    printf "%s\n" "Missing required program $1" 1<&2
    false
  fi
}

require_root () {
  if [ "$user_id" -ne 0 ]; then
    printf "%s\n" "Requires root" 1<&2
    exit 1
  fi
}

check_dependency tmux || exit 1
check_dependency git || exit 1
check_dependency rsync || exit 1
check_dependency tar || exit 1
check_dependency java || exit 1

if [ "$1" == "install" ]; then
  require_root

  if [ ! -d /etc/pam.d ]; then
    printf "%s\n" "Requires PAM" 1<&2
    exit 1
  fi

  if [ -f "$bin_dir/$pname" ]; then
    printf "%s\n" "$pname is already installed" 1<&2
    exit 1
  fi

  script_file="$2"
  if [ ! -f "$script_file" ]; then
    printf "%s\n" "Failed to locate $script_file; cannot install" 1<&2
    exit 1
  fi

  if [ -z "$( grep -E "# c2301c68dfe54232af2a63a47cc8b782" < "$script_file" )" ]; then
      printf "%s\n" "$script_file is not the correct script file" 1<&2
      exit 1
  fi

  # User/group management
  groupadd -f server_access
  useradd -m "$server_user"
  usermod -aG server_access "$server_user"

  # Necessary directories
  mkdir -p "$bin_dir" "$data_dir" "$log_dir"

  # rwxr-x--- perms on the data dir, rwx------ perms on the log dir
  chmod 750 "$data_dir"
  chmod 700 "$log_dir"

  chown "$server_user" "$data_dir" "$log_dir"
  chgrp server_access "$data_dir" "$log_dir"

  start_file="$common/start.sh"

  # Make all required directories and symlinks as $server_user
  su "$server_user" -c "
  mkdir -p \"$pid_dir\" \"$server_1\" \"$server_2\" \"$server_1_unique\" \"$server_2_unique\" \"$config\" \"$build\" \"$src\" \"$common\"

  ln -s \"$log_dir\" \"$logs\"
  touch \"$main_pid_file\" \"$fallback_pid_file\" \"$temp_log\" \"$signal\"

  tmux -S \"$socket_1\" new-session -d -n server -s server &> /dev/null
  tmux -S \"$socket_2\" new-session -d -n server -s server &> /dev/null

  ln -s \"$socket_1\" \"$main_socket\"
  ln -s \"$socket_2\" \"$fallback_socket\"

  ln -s \"$server_1\" \"$main\"
  ln -s \"$server_2\" \"$fallback\"

  printf \"%s\" \"#!/bin/bash\nprintf \"\" > \"$signal\"\njava -Dfile.encoding=UTF-8 -jar server.jar\nprintf \"%s\\n\" \"FINISHED\" > \"$signal\"\" > \"$start_file\"
  chmod 700 \"$start_file\" \"$signal\""

  # Set rw-rw---- perms on each socket
  chmod 660 "$socket_1" "$socket_2"
  chgrp server_access "$socket_1" "$socket_2"

  # Create the install file, make sure it's owned by root
  touch "$bin_dir/$pname"
  chown root "$bin_dir/$pname"
  chgrp root "$bin_dir/$pname"
  chmod 755 "$bin_dir/$pname"

  # Copy this script over
  cat "$script_file" > "$bin_dir/$pname"

  # Generate new /etc/pam.d/su file
  new_file=$(
  sed '/^[[:space:]]\{0,\}auth[[:space:]]\{1,\}sufficient[[:space:]]\{1,\}pam_rootok\.so[[:space:]]\{0,\}$/a\
# AUTOGENERATED, DO NOT EDIT c2301c68dfe54232af2a63a47cc8b782\
auth [success=ignore default=1] pam_succeed_if.so user = phantazm-server\
auth sufficient pam_succeed_if.so use_uid user ingroup server_access\
# END AUTOGENERATED SECTION' /etc/pam.d/su
  )

  printf "%s" "$new_file" > /etc/pam.d/su
  printf "%s" "Is your configuration repository '$config_repo' private? [y/n] "

  read -r response
  if [ "$response" == "y" ]; then
    printf "Enter the hostname of the repository (ex. github.com): "
    read -r hostname

    while true ; do
      printf "Enter a path to a passwordless SSH identity file (private key): "
      read -r key_path

      if [ ! -f "$key_path" ]; then
        printf "%s\n" "Cannot find the file referenced by $key_path" 1<&2
      else
        break
      fi
    done

    ssh_dir="/home/$server_user/.ssh"
    su "$server_user" -c "
    mkdir -p \"$ssh_dir\"
    touch \"$ssh_dir/config\"
    touch \"$ssh_dir/key\""

    config_file="$ssh_dir/config"
    key_file="$ssh_dir/key"

    chmod 700 "$ssh_dir"
    chmod 644 "$config_file"
    chmod 600 "$key_file"

    cat "$key_path" > "$key_file"

    printf "%s" "Host Configuration
    Hostname $hostname
    IdentityFile=$key_file
    IdentitiesOnly yes" > "$config_file"
  else
    printf "%s\n" "Skipping credential initialization..."
  fi

  printf "%s\n" "Installation complete. Some notes:
  * In order to allow users to use $pname commands, you must add them using $pname allow [user].
  * You will need to add worlds (or symlinks to worlds) inside $common.
  * Server files are located in $server_dir.
  * Server logs are located in $log_dir.
  * SSH identity file located in /home/$server_user/.ssh/key, if using a private repository.
  * Since changes to user permissions were made, you may have to log out and back in again."
  exit 0
fi

if [ ! -f "$bin_dir/$pname" ]; then
  printf "%s\n" "$pname has not been installed; do so by running '$pname install [path-to-this-script-file]' with root permissions." 1<&2
  exit 1
fi

if [ "$1" == "uninstall" ]; then
  require_root

  printf "%s\n" "Warning: uninstalling will abruptly kill any active servers!"
  printf "Are you sure you want to proceed? [y/n] "
  read -r user_input

  if [ "$user_input" != "y" ]; then
    exit 0
  fi

  tmux -S "$socket_1" kill-server
  tmux -S "$socket_2" kill-server

  su "$server_user" -c "
  cd \"$src\"
  ./gradlew --stop"

  # $bin_dir and $pname are both constants, but be careful anyway
  rm -rf "$data_dir" "${bin_dir:?}/$pname" "$log_dir" "$pid_dir"

  userdel -fr "$server_user"
  groupdel server_access

  new_file=$(sed '/# AUTOGENERATED, DO NOT EDIT c2301c68dfe54232af2a63a47cc8b782/,/# END AUTOGENERATED SECTION/d' /etc/pam.d/su)
  printf "%s" "$new_file" > /etc/pam.d/su

  exit 0
fi

is_in_group () {
  for group in $(id -Gn "$2") ; do
    if [ "$group" = "$1" ]; then
      return 0
    fi
  done

  return 1
}

require_server_access () {
  if ! is_in_group server_access "$user_id"; then
    printf "%s\n" "Current user must be part of the 'server_access' group!" 1<&2
    exit 1
  fi
}

# Ensures that the server.tar.gz file exists
require_blob () {
  su "$server_user" -c "
  if [ ! -f \"$blob\" ]; then
    printf \"%s\\n\" \"Missing required file '$blob'. Running '$pname deploy-src' should generate it, or else it can be brought in externally.\" 1<&2
    exit 1
  fi" || exit 1
}

# Updates the config directory to the latest branch
update_config () {
  su "$server_user" -c "
  cd \"$config\" || exit 1

  if [ ! -d \"$config/.git\" ]; then
    rm -rf \"$config\"
    cd .. || exit 1
    git clone \"$config_repo\" \"$config\" || exit 1
    cd \"$config\" || exit 1
  fi

  git checkout \"$config_branch\" || exit 1
  git pull" || exit 1
}

# Checks if a given server process ID is empty or doesn't exist
check_status () {
  if [ -z "$1" ]; then
    printf "false"
  else
    if [ -z "$(ps -p "$1" -o args | grep -E "/usr/local/etc/$pname/(main|fallback)")" ]; then
      printf "false"
    else
      printf "true"
    fi
  fi
}

tmux_init () {
  su "$server_user" -c "
  tmux -S \"$socket_1\" new-session -d -n server -s server &> /dev/null
  tmux -S \"$socket_2\" new-session -d -n server -s server &> /dev/null
  tmux -S \"$socket_1\" server-access -a \"$user_id\" &> /dev/null
  tmux -S \"$socket_2\" server-access -a \"$user_id\" &> /dev/null"
}

if [ "$1" == "main" ]; then
  require_server_access
  tmux_init

  tmux -S "$main_socket" attach-session
  exit "$?"
elif [ "$1" == "allow" ]; then
  require_root
  if [ -z "$2" ]; then
    printf "Must specify a user to allow\n"
    exit 1
  fi

  usermod -aG server_access "$2" || exit 1
  exit 0
elif [ "$1" == "deny" ]; then
  require_root
  if [ -z "$2" ]; then
    printf "Must specify a user to deny\n"
    exit 1
  fi

  usermod -rG server_access "$2" || exit 1
  tmux -S "$socket_1" server-access -d "$2"
  tmux -S "$socket_2" server-access -d "$2"
  exit 0
elif [ "$1" == "status" ]; then
  require_server_access

  main_pid=$(su "$server_user" -c "cat \"$main_pid_file\"")
  fallback_pid=$(su "$server_user" -c "cat \"$fallback_pid_file\"")

  main_is_running=$(check_status "$main_pid")
  fallback_is_running=$(check_status "$fallback_pid")

  if [ "$main_is_running" == "true" ]; then
    main_status="Running"
  else
    main_status="Stopped"
  fi

  if [ "$main_is_running" == "true" ]; then
    fallback_status="Running"
  else
    fallback_status="Stopped"
  fi

  printf "%s\n%s" "'main' status: $main_status" "'fallback' status: $fallback_status"
  exit 0
elif [ "$1" == "fallback" ]; then
  require_server_access
  tmux_init

  tmux -S "$fallback_socket" attach-session
  exit "$?"
elif [ "$1" == "shutdown" ]; then
  require_server_access
  tmux_init

  tmux -S "$main_socket" send-keys -t server orderly_shutdown Enter
  exit "$?"
elif [ "$1" == "restart" ]; then
  require_server_access
  no_sync="true"
elif [ "$1" == "deploy-src" ]; then
  require_server_access
  su "$server_user" -c "rm -rf \"$build\" && mkdir \"$build\""

  update_config

  su "$server_user" -c "
  cd \"$src\" || exit 1
  if [ ! -d \"$src/.git\" ]; then
    rm -rf \"$src\"
    cd .. || exit 1
    git clone --recurse-submodules \"$code_repo\" \"$src\" || exit 1
    cd \"$src\" || exit 1
  fi

  git checkout \"$code_branch\" && git pull --recurse-submodules
  ./gradlew -PskipBuild=snbt-builder,dev-launcher,velocity phantazm-server:copyJar phantazm-server:copyLibs
  cp -r \"run/server-1/libs\" \"$build/\" || exit 1
  cp \"run/server-1/server.jar\" \"$build/\" || exit 1

  tar -czf \"$blob\" -C \"$server_dir\" build || exit 1" || exit 1
elif [ "$1" == "deploy" ]; then
  require_server_access
  require_blob

  su "$server_user" -c "
  rm -rf \"$build\" && mkdir \"$build\"
  tar -xzf \"$blob\" -C \"$server_dir\" build || exit 1" || exit 1
elif [ "$1" == "deploy-conf" ]; then
  require_server_access
  require_blob

  update_config

  su "$server_user" -c "
  rm -rf \"$build\" && mkdir \"$build\"
  tar -xzf \"$blob\" -C \"$server_dir\" build || exit 1" || exit 1
elif [ "$1" == "help" ]; then
  printf "USAGE: %s OPTION\n\n" "$pname"
  printf "%s orchestrates Phantazm servers. It allows for safely re-launching with\n" "$pname"
  printf "updated configuration or code, without abruptly ending existing games.\n\n"
  printf "Valid values for OPTION:\n"
  printf "  help           Prints this help message and exits.\n"
  printf "  allow [user]   Allows a user to attach to or run servers. Requires root.\n"
  printf "  deny [user]    Denies a user to attach to or run servers. Requires root.\n"
  printf "  status         Prints the current status of the main & fallback servers.\n"
  printf "  main           Attaches to the main server terminal.\n"
  printf "  fallback       Attaches to the fallback server terminal.\n"
  printf "  shutdown       Shuts down the main server.\n"
  printf "  restart        Restarts the main server, or starts it if it is not running.\n"
  printf "  deploy-src     Builds the server from source, synchronizes configuration,\n"
  printf "                 then launches (or restarts) it.\n"
  printf "  deploy-conf    Synchronizes configuration, then restarts the server. Requires\n"
  printf "                 the server.tar.gz file to exist.\n"
  printf "  deploy         Restarts the server. Requires the server.tar.gz file to exist.\n"
  printf "  install        Installs %s, if it is not already installed.\n" "$pname"
  printf "  uninstall      Uninstalls %s, if it is installed.\n" "$pname"
  exit 0
elif [ -n "$1" ]; then
  require_server_access
  printf "%s\n" "Unknown directive $1; try '$pname help' for more info" 1<&2
  exit 1
else
  require_server_access
  printf "%s\n" "Incorrect usage; try running '$pname help' for more info" 1<&2
  exit 1
fi

# Simple folder-based mutex
if ! su "$server_user" -c "mkdir \"$lock_folder\""; then
  printf "%s\n" "An instance of $pname is already running!" 1<&2
  printf "%s\n" "If this is an error, run 'rm -rf $lock_folder' and try launching $pname again." 1<&2
  exit 1
fi

exit_hook () {
  su "$server_user" -c "rmdir \"$lock_folder\""
}

trap "exit_hook" EXIT

## Setup

# Make sure the tmux sessions are running & allow access to the current user
tmux_init

## Function definitions

# Promotes the fallback server to the main server. Should be called if the fallback server is the only running server.
promote_fallback () {
  su "$server_user" -c "
  cat \"$fallback_pid_file\" > \"$main_pid_file\"
  printf \"\" > \"$fallback_pid_file\"

  new_active=\$(readlink \"$fallback_socket\")
  new_server=\$(readlink \"$fallback\")

  if [ \"\$new_active\" == \"$socket_1\" ]; then
    old_active=\"$socket_2\"
    old_server=\"$server_2\"
  else
    old_active=\"$socket_1\"
    old_server=\"$server_1\"
  fi

  rm \"$fallback_socket\" \"$main_socket\" \"$fallback\" \"$main\"

  ln -s \"\$old_active\" \"$fallback_socket\"
  ln -s \"\$new_active\" \"$main_socket\"

  ln -s \"\$old_server\" \"$fallback\"
  ln -s \"\$new_server\" \"$main\""
}

synchronize_target () {
  if [ -z "$no_sync" ]; then
    su "$server_user" -c "
    target=\$(readlink \"$1\")
    if [ \"\$target\" == \"$server_1\" ]; then
      rsync -ac --delete \"$server_1_unique/\" \"$common/\" \"$build/\" \"$config/\" \"$1\" || exit 1
    elif [ \"\$target\" == \"$server_2\" ]; then
      rsync -ac --delete \"$server_2_unique/\" \"$common/\" \"$build/\" \"$config/\" \"$1\" || exit 1
    else
      printf \"%s\\n\" \"Invalid synchronize symlink $1 -> \$target; exiting (no server files have changed)\" 1<&2
      exit 1
    fi" || exit 1
  fi
}

## Server startup

main_pid=$(su "$server_user" -c "cat \"$main_pid_file\"")
fallback_pid=$(su "$server_user" -c "cat \"$fallback_pid_file\"")

main_is_running=$(check_status "$main_pid")
fallback_is_running=$(check_status "$fallback_pid")

if [ "$main_is_running" == "false" ] && [ "$fallback_is_running" == "false" ]; then
  synchronize_target "$main"

  tmux -S "$main_socket" send-keys -t server "sh -c 'cd \"$main\"; printf \"%s\" \"\$\$\" > \"$main_pid_file\"; exec ./start.sh'" Enter
  su "$server_user" -c "printf \"%s\" \"\" > \"$fallback_pid_file\""
elif [ "$main_is_running" == "true" ] && [ "$fallback_is_running" == "false" ]; then
  synchronize_target "$fallback"

  su "$server_user" -c "cat \"\" > \"$temp_log\""
  tmux -S "$fallback_socket" send-keys -t "server" "sh -c 'cd \"$fallback\"; printf \"%s\" \"\$\$\" > \"$fallback_pid_file\"; exec ./start.sh | tee \"$temp_log\"'" Enter

  # Wait for "serverIP" to show up in the log file (indicating the fallback server started)
  su "$server_user" -c "
  ( tail -f -n +1 \"$temp_log\" & ) | grep -q \"serverIP\"
  cat \"\" > \"$temp_log\""

  # Shut down the main server (the fallback is running).
  tmux -S "$main_socket" send-keys -t server "orderly_shutdown" Enter

  # The start script start.sh prints FINISHED into $signal just before shutting down.
  # $signal will be empty if it's running.
  su "$server_user" -c "( tail -f -n +1 \"$signal\" & ) | grep -q \"FINISHED\""

  promote_fallback
elif [ "$main_is_running" == "false" ] && [ "$fallback_is_running" == "true" ]; then
  printf "%s\n" "Warning: Invalid state detected, 'fallback' is alive but 'main' is not.
  $pname will attempt to promote the fallback instance to the main instance.
  If changes were deployed, they will not be visible in the new instance.
  You can try running $pname again to apply them." 1<&2

  promote_fallback
else
  printf "Both main and fallback are running! This is likely an error (did something break our mutex?), doing nothing.\n" 1<&2
  exit 1
fi
